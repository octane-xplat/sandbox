{
	"name": "@octane-xplat/sandbox",
	"private": true,
	"type": "module",
	"main": "src/main.tsrx",
	"scripts": {
		"xplat": "xplat",
		"dev": "xplat dev web",
		"dev:ios": "ns run ios --disable-npm-install",
		"dev:android": "ns run android --disable-npm-install",
		"build": "xplat build --targets web",
		"build:ios": "ns build ios --disable-npm-install",
		"build:android": "ns build android --disable-npm-install",
		"test": "vitest run --config vitest.web.config.mts",
		"test:web": "vitest run --config vitest.web.config.mts",
		"test:ios": "ns test ios --disable-npm-install",
		"test:android": "ns test android --disable-npm-install",
		"lint": "xplat lint",
		"lint:fix": "xplat lint --fix",
		"typecheck": "xplat typecheck",
		"format": "xplat fmt",
		"workshop": "xplat workshop dev --target web",
		"dev:octane": "node links/dev-octane.cjs",
		"test:links": "node --test links/octane.test.cjs",
		"dev:published": "node links/published.cjs",
		"profile:build:android": "python3 tools/profiling/profile_grid.py build android",
		"profile:build:ios": "python3 tools/profiling/profile_grid.py build ios",
		"profile:android": "python3 tools/profiling/profile_grid.py record android",
		"profile:ios": "python3 tools/profiling/profile_grid.py record ios",
		"test:profiling": "python3 -m unittest discover -s tools/profiling -p \"test_*.py\""
	},
	"dependencies": {
		"@nativescript-community/octane": "catalog:xplat",
		"@nativescript/core": "catalog:xplat",
		"@octane-xplat/jsx": "catalog:xplat",
		"@octane-xplat/nativescript-mason-core": "catalog:xplat",
		"@octane-xplat/platform": "catalog:xplat",
		"@octane-xplat/ui": "catalog:xplat",
		"@valor/nativescript-websockets": "catalog:xplat",
		"octane": "catalog:xplat"
	},
	"devDependencies": {
		"@nativescript-community/vite-octane": "catalog:xplat",
		"@nativescript/android": "catalog:xplat",
		"@nativescript/ios": "catalog:xplat",
		"@nativescript/types": "catalog:xplat",
		"@nativescript/unit-test-runner": "catalog:xplat",
		"@nativescript/vite": "catalog:xplat",
		"@octane-xplat/workshop": "catalog:xplat",
		"@octanejs/vite-plugin": "catalog:xplat",
		"@tsrx/oxc": "catalog:xplat",
		"jsdom": "catalog:xplat",
		"nativescript": "catalog:xplat",
		"octane-xplat": "catalog:xplat",
		"typescript-classic": "catalog:xplat",
		"vite": "catalog:xplat",
		"vitest": "catalog:xplat"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"packageManager": "pnpm@11.24.0",
	"description": "A small playground for experimenting with Octane Xplat on web, iOS, and Android.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/sandbox.git"
	}
}
